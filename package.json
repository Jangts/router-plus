{
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @jangts/router-plus --",
    "test": "npm test --workspace @jangts/router-plus --",
    "check": "npm run check --workspace @jangts/router-plus --",
    "build:packages": "npm run build",
    "format": "prettier --ignore-unknown --write \"packages/router-plus/src/**\" \"packages/router-plus/scripts/**\" \"shared/**\"",
    "format:check": "prettier --ignore-unknown --check \"packages/router-plus/src/**\" \"packages/router-plus/scripts/**\" \"shared/**\"",
    "docs:router-plus": "npm run dev --workspace @jangts/router-plus-docs --",
    "build:docs:router-plus": "npm run build --workspace @jangts/router-plus-docs --",
    "preview:docs:router-plus": "npm run preview --workspace @jangts/router-plus-docs --",
    "check:docs:router-plus": "npm run check --workspace @jangts/router-plus-docs --"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
